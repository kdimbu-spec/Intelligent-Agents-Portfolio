      "source": [
        "import pandas as pd\n",
        "\n",
        "def research_interface(question_text, limit_val, use_llm_val, email_val):\n",
        "    journal_logs = []\n",
        "    errors = []\n",
        "\n",
        "    journal_logs.append(f\"[Journal] Starting research on: \\\"{question_text}\\\" with limit {limit_val}\")\n",
        "\n",
        "    try:\n",
        "        # 1. Plan tasks\n",
        "        journal_logs.append(\"[Journal] Activating Planner Agent...\")\n",
        "        plan = planner_agent(question_text)\n",
        "        tasks = plan.get(\"tasks\", [])\n",
        "\n",
        "        # 2. Retrieve papers\n",
        "        journal_logs.append(f\"[Journal] Retrieving papers for {len(tasks)} planned sub-queries...\")\n",
        "        raw_papers = []\n",
        "        for task in tasks:\n",
        "            retrieved = retrieve_papers(task[\"query\"])\n",
        "            raw_papers.extend(retrieved)\n",
        "\n",
        "        # 3. Deduplicate\n",
        "        journal_logs.append(f\"[Journal] Deduplicating {len(raw_papers)} raw results...\")\n",
        "        unique_papers = deduplicate_papers(raw_papers)\n",
        "        journal_logs.append(f\"[Journal] Found {len(unique_papers)} unique papers.\")\n",
        "\n",
        "        # 4. Limit to requested max papers\n",
        "        selected_papers = unique_papers[:int(limit_val)]\n",
        "\n",
        "        # 5. Process / Summarize papers\n",
        "        journal_logs.append(f\"[Journal] Processing and evaluating top {len(selected_papers)} papers...\")\n",
        "        processed_list = []\n",
        "        for paper in selected_papers:\n",
        "            processed_paper = process_paper(paper, question_text)\n",
        "            processed_list.append(processed_paper)\n",
        "\n",
        "            # Save to Vector DB memory\n",
        "            try:\n",
        "                memory.store_paper(\n",
        "                    title=processed_paper.get(\"title\", \"\"),\n",
        "                    summary=processed_paper.get(\"processed_summary\", \"\"),\n",
        "                    source=processed_paper.get(\"source\", \"\"),\n",
        "                    url=processed_paper.get(\"url\", \"\"),\n",
        "                    research_question=question_text\n",
        "                )\n",
        "            except Exception as mem_ex:\n",
        "                errors.append(f\"Memory write warning: {mem_ex}\")\n",
        "\n",
        "        # Rank by score\n",
        "        processed_list.sort(key=lambda x: x.get(\"relevance_score\", 0), reverse=True)\n",
        "\n",
        "        # 6. Generate gaps analysis using top processed papers\n",
        "        journal_logs.append(\"[Journal] Identifying research gaps and synthesizing literature...\")\n",
        "        gap_analysis = identify_research_gaps(processed_list)\n",
        "\n",
        "        # 7. Formulate a structured Markdown report\n",
        "        journal_logs.append(\"[Journal] Formulating final markdown report...\")\n",
        "        report_md = f\"# Research Synthesis Report\\n\\n**Question:** {question_text}\\n\\n\"\n",
        "        for idx, paper in enumerate(processed_list[:5]):\n",
        "            report_md += f\"### {idx+1}. {paper.get('title', 'Untitled')}\\n\"\n",
        "            report_md += f\"* **Source:** {paper.get('source', 'Unknown')} | **Year:** {paper.get('year', 'N/A')} | **Score:** {paper.get('relevance_score', 0)} ({paper.get('score_reason', '')})\\n\"\n",
        "            report_md += f\"* **Quality:** {paper.get('evidence_quality', 'Unknown')}\\n\"\n",
        "            report_md += f\"* **Summary:**\\n{paper.get('processed_summary', 'No summary available.')}\\n\\n\"\n",
        "\n",
        "        # Convert papers to DataFrame for output view\n",
        "        df_rows = []\n",
        "        for p in processed_list:\n",
        "            df_rows.append({\n",
        "                \"Title\": p.get(\"title\", \"\"),\n",
        "                \"Year\": p.get(\"year\", \"\"),\n",
        "                \"Source\": p.get(\"source\", \"\"),\n",
        "                \"Relevance Score\": p.get(\"relevance_score\", 0),\n",
        "                \"Quality\": p.get(\"evidence_quality\", \"\")\n",
        "            })\n",
        "        df_output = pd.DataFrame(df_rows)\n",
        "\n",
        "        journal_logs.append(\"[Journal] Task complete!\")\n",
        "\n",
        "        return (\n",
        "            report_md,\n",
        "            gap_analysis,\n",
        "            \"\\n\".join(journal_logs),\n",
        "            \"\\n\".join(errors) if errors else \"No errors detected.\",\n",
        "            df_output\n",
        "        )\n",
        "\n",
        "    except Exception as e:\n",
        "        journal_logs.append(f\"[Journal] Execution failed with error: {str(e)}\")\n",
        "        return (\n",
        "            \"# Research Failure\",\n",
        "            \"Unable to generate analysis.\",\n",
        "            \"\\n\".join(journal_logs),\n",
        "            f\"Error during run: {str(e)}\\n{str(errors)}\",\n",
        "            pd.DataFrame()\n",
        "        )"
      ]
    },
