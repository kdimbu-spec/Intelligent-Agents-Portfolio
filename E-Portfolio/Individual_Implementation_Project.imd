    {
      "cell_type": "markdown",
      "metadata": {
        "id": "QjK0E4ndqHAX"
      },
      "source": [
        "# Create Workflow Orchestrator\n",
        "\n",
        "This controls the agents."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "Z2f_V_XpqOMg"
      },
      "outputs": [],
      "source": [
        "def run_research(\n",
        "    research_question,\n",
        "    sources,\n",
        "    max_cycles=1\n",
        "):\n",
        "\n",
        "    state = ResearchState(\n",
        "        question=research_question\n",
        "    )\n",
        "\n",
        "    state.plan = planner_agent(\n",
        "        research_question\n",
        "    )\n",
        "\n",
        "    all_papers = []\n",
        "\n",
        "    tasks = state.plan[\"tasks\"]\n",
        "\n",
        "    for task in tasks:\n",
        "\n",
        "        papers = retrieve_papers(\n",
        "            task[\"query\"]\n",
        "        )\n",
        "\n",
        "        all_papers.extend(\n",
        "            papers\n",
        "        )\n",
        "\n",
        "    state.retrieved_papers = (\n",
        "        deduplicate_papers(\n",
        "            all_papers\n",
        "        )\n",
        "    )\n",
        "\n",
        "    state.cycle = 1\n",
        "\n",
        "    state.sufficient = (\n",
        "        len(\n",
        "            state.retrieved_papers\n",
        "        ) > 0\n",
        "    )\n",
        "\n",
        "    return state"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "tSRn3Y3ZqkZh",
        "outputId": "d1ea1779-2092-4338-b8ed-cbb0a318dd2e"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Papers found: 15\n"
          ]
        }
      ],
      "source": [
        "state = run_research(\n",
        "    research_question=\n",
        "    \"The impact of modern technology on student learning experiences in higher education in europe\",\n",
        "\n",
        "    sources=[\n",
        "        \"arxiv\",\n",
        "        \"openalex\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Papers found: \"\n",
        "    f\"{len(state.retrieved_papers)}\"\n",
        ")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "cVCEMp1YsIMr"
      },
      "source": [
        "# Configure Groq API"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "Lt9YpENisXAo",
