    {
      "cell_type": "markdown",
      "metadata": {
        "id": "AI2p0VeU4ChP"
      },
      "source": [
        "## Research Gap Agent\n",
        "\n",
        "Use the LLM to identify trends and gaps across retrieved literature."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "3P3rVaM13JGK"
      },
      "outputs": [],
      "source": [
        "def identify_research_gaps(\n",
        "    papers\n",
        "):\n",
        "\n",
        "    corpus = \"\\n\\n\".join(\n",
        "        f\"Title: {p.get('title', '')}\\nSummary:\\n{p.get('processed_summary', '')[:800]}\"\n",
        "        for p in papers[:5]\n",
        "    )\n",
        "\n",
        "    response = (\n",
        "        client.chat.completions.create(\n",
        "            model=\n",
        "            \"openai/gpt-oss-120b\",\n",
        "\n",
        "            messages=[\n",
        "                {\n",
        "                    \"role\":\"system\",\n",
        "                    \"content\":\n",
        "                    \"\"\"\n",
        "                    Review the literature.\n",
        "\n",
        "                    Identify:\n",
        "\n",
        "                    1. Common themes\n",
        "                    2. Research gaps\n",
        "                    3. Future work\n",
        "\n",
        "                    Return in markdown.\n",
        "                    \"\"\"\n",
        "                },\n",
        "\n",
        "                {\n",
        "                    \"role\":\"user\",\n",
        "                    \"content\": corpus\n",
        "                }\n",
        "            ]\n",
        "        )\n",
        "    )\n",
        "\n",
        "    return (\n",
        "\n",
        "        response\n",
        "        .choices[0]\n",
        "        .message.content\n",
        "    )"
      ]
    },
