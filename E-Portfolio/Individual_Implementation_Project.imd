        "with gr.Blocks(\n",
        "    title=\"Multi-Agent Academic Research Assistant\"\n",
        ") as demo:\n",
        "\n",
        "    gr.Markdown(\n",
        "        \"\"\"\n",
        "        # Multi-Agent Academic Research Assistant\n",
        "\n",
        "        Search academic literature, generate summaries,\n",
        "        identify research gaps and leverage persistent memory.\n",
        "        \"\"\"\n",
        "    )\n",
        "\n",
        "    with gr.Row():\n",
        "\n",
        "        question = gr.Textbox(\n",
        "            label=\"Research Question\",\n",
        "            lines=3,\n",
        "            placeholder=\"Enter your research topic...\"\n",
        "        )\n",
        "\n",
        "    with gr.Row():\n",
        "\n",
        "        limit = gr.Slider(\n",
        "            minimum=5,\n",
        "            maximum=50,\n",
        "            value=10,\n",
        "            step=1,\n",
        "            label=\"Maximum Papers\"\n",
        "        )\n",
        "\n",
        "        use_llm = gr.Checkbox(\n",
        "            value=True,\n",
        "            label=\"Use LLM Summarization\"\n",
        "        )\n",
        "\n",
        "    email = gr.Textbox(\n",
        "        label=\"Email (Optional)\",\n",
        "        placeholder=\"Required for some APIs\"\n",
        "    )\n",
        "\n",
        "    search_btn = gr.Button(\n",
        "        \"Run Research\",\n",
        "        variant=\"primary\"\n",
        "    )\n",
        "\n",
        "    with gr.Tab(\"Research Report\"):\n",
        "        report_output = gr.Markdown()\n",
        "\n",
        "    with gr.Tab(\"Research Gaps\"):\n",
        "        gap_output = gr.Markdown()\n",
        "\n",
        "    with gr.Tab(\"Agent Journal\"):\n",
        "        journal_output = gr.Textbox(\n",
        "            lines=20\n",
        "        )\n",
        "\n",
        "    with gr.Tab(\"Errors\"):\n",
        "        error_output = gr.Textbox(\n",
        "            lines=10\n",
        "        )\n",
        "\n",
        "    with gr.Tab(\"Retrieved Papers\"):\n",
        "        papers_output = gr.DataFrame()\n",
        "\n",
        "    search_btn.click(\n",
        "        fn=research_interface,\n",
        "        inputs=[\n",
        "            question,\n",
        "            limit,\n",
        "            use_llm,\n",
        "            email\n",
        "        ],\n",
        "        outputs=[\n",
        "            report_output,\n",
        "            gap_output,\n",
        "            journal_output,\n",
        "            error_output,\n",
        "            papers_output\n",
        "        ]\n",
        "    )\n",
        "\n",
        "demo.launch(\n",
        "    debug=True,\n",
        "    share=True\n",
        ")"
