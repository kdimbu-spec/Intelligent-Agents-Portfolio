      "source": [
        "for paper in state.processed_papers[:5]:\n",
        "\n",
        "    print(\n",
        "        \"\\nTITLE:\",\n",
        "        paper[\"title\"]\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"SCORE:\",\n",
        "        paper[\"relevance_score\"]\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"QUALITY:\",\n",
        "        paper[\"evidence_quality\"]\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"REASON:\",\n",
        "        paper[\"score_reason\"]\n",
        "    )\n",
        "\n",
        "    print(\"-\" * 50)"
      ]
