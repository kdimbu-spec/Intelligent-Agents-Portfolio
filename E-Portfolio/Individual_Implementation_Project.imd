              " 'summary': 'Abstract not available',\n",
              " 'doi': 'https://doi.org/10.1051/shsconf/202315606003',\n",
              " 'year': 2023,\n",
              " 'citations': 5,\n",
              " 'url': 'https://openalex.org/W4320016324',\n",
              " 'source': 'openalex'}"
            ]
          },
          "execution_count": 9,
          "metadata": {},
          "output_type": "execute_result"
        }
      ],
      "source": [
        "##Testing\n",
        "papers = search_openalex(\n",
        "    \"The impact of modern technology on student learning experiences in higher education in europe\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    len(papers)\n",
        ")\n",
        "\n",
        "papers[0]"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "U36YI1H6oLFd"
      },
      "source": [
        "# Create Parallel Retrieval Agent\n",
        "\n",
        "Instead of waiting for one source at a time, query them simultaneously."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "fJk3oiZkoowa"
      },
      "outputs": [],
      "source": [
        "from concurrent.futures import (\n",
        "    ThreadPoolExecutor\n",
        ")\n",
        "\n",
        "def retrieve_papers(\n",
        "    query\n",
        "):\n",
        "\n",
        "    papers = []\n",
        "\n",
        "    with ThreadPoolExecutor(\n",
        "        max_workers=2\n",
        "    ) as executor:\n",
        "\n",
        "        arxiv_future = executor.submit(\n",
        "            search_arxiv,\n",
        "            query\n",
        "        )\n",
        "\n",
        "        openalex_future = executor.submit(\n",
        "            search_openalex,\n",
        "            query\n",
        "        )\n",
        "\n",
        "        papers.extend(\n",
        "            arxiv_future.result()\n",
        "        )\n",
        "\n",
        "        papers.extend(\n",
        "            openalex_future.result()\n",
        "        )\n",
        "\n",
        "    return papers"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "YXWF7_Sco2H9",
        "outputId": "2628be97-d258-4aef-f93b-a3b468618460"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Retrieved 10 papers\n"
          ]
        }
      ],
      "source": [
        "papers = retrieve_papers(\n",
        "    \"Explainable AI Healthcare\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Retrieved {len(papers)} papers\"\n",
        ")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "_DNUyQXTpPkH"
      },
      "source": [
        "# Create Deduplication Agent\n",
        "\n",
        "Some papers appear in multiple databases."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "S5eDhKPdpdgt"
      },
      "outputs": [],
      "source": [
        "def deduplicate_papers(\n",
        "    papers\n",
        "):\n",
        "\n",
        "    unique = {}\n",
        "\n",
        "    for paper in papers:\n",
        "\n",
        "        key = paper.get(\n",
        "            \"title\",\n",
        "            \"\"\n",
        "        ).lower()\n",
        "\n",
        "        if key not in unique:\n",
        "\n",
        "            unique[key] = paper\n",
        "\n",
        "    return list(\n",
        "        unique.values()\n",
        "    )"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
